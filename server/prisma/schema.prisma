generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model Admin {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           AdminRole       @default(ADMIN)
  sessions       AdminSession[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([role])
}

model AdminSession {
  tokenHash     String   @id @db.Char(64)
  csrfTokenHash String   @db.Char(64)
  adminId       String
  admin         Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String          @db.Text
  price          Decimal         @db.Decimal(10, 2)
  imageUrl       String?
  stockQuantity  Int             @default(0)
  isAvailable    Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  categoryId     String
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([categoryId])
  @@index([isAvailable, isFeatured])
  @@index([stockQuantity])
}

model StockMovement {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  adminId          String?
  admin            Admin?   @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quantityChange   Int
  previousQuantity Int
  newQuantity      Int
  reason           String   @db.VarChar(500)
  createdAt        DateTime @default(now())

  @@index([productId, createdAt])
  @@index([adminId, createdAt])
  @@index([orderId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?  @unique
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  checkoutKey   String?       @unique
  checkoutHash  String?       @db.Char(64)
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryAddress String      @default("") @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  deliveryFee   Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)
  items         OrderItem[]
  stockMovements  StockMovement[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([customerId])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

model StoreSettings {
  id                  String   @id @default(cuid())
  shopName            String
  whatsappNumber      String?
  contactNumber       String?
  address             String?  @db.Text
  openingHours        String?  @db.Text
  deliveryInformation String?  @db.Text
  deliveryFee         Decimal  @default(0) @db.Decimal(10, 2)
  minimumOrderAmount  Decimal  @default(0) @db.Decimal(10, 2)
  isOperating         Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}
